# ─────────────────────────────────────────────────────────────────────────────
# SciLoop — Scientific Sandbox Dockerfile
# Python environment with RDKit, Biopython, and scientific libraries
# Used for molecular filtering, scoring, and computational experiments
# ─────────────────────────────────────────────────────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /app

# Install system dependencies required by RDKit
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libboost-all-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy and install Python dependencies
COPY sandbox-scripts/requirements.txt ./
RUN pip install --no-cache-dir --user -r requirements.txt

# ─────────────────────────────────────────────────────────────────────────────
FROM python:3.11-slim

LABEL org.opencontainers.image.title="sciloop-sandbox"
LABEL org.opencontainers.image.description="Scientific sandbox with RDKit, Biopython for SciLoop experiments"
LABEL org.opencontainers.image.version="1.0.0"

# Run as non-root user
RUN groupadd -g 1001 sciloop && useradd -u 1001 -g sciloop -m sciloop

# Copy Python packages from builder
COPY --from=builder /root/.local /home/sciloop/.local

# Copy sandbox scripts
COPY --chown=sciloop:sciloop sandbox-scripts/ /app/sandbox-scripts/

WORKDIR /app
USER sciloop

# Ensure user-installed packages are on PATH
ENV PATH="/home/sciloop/.local/bin:${PATH}"
ENV PYTHONPATH="/app"
ENV PYTHONUNBUFFERED=1

# Validate RDKit installation
RUN python -c "from rdkit import Chem; print('RDKit OK:', Chem.MolFromSmiles('CCO').GetNumAtoms())" || true

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD python -c "import rdkit; print('ok')" || exit 1

ENTRYPOINT ["python"]
