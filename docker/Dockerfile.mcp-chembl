# ─────────────────────────────────────────────────────────────────────────────
# SciLoop — ChEMBL MCP Server Dockerfile
# Wraps the ChEMBL REST API
# ─────────────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

COPY mcp-servers/chembl-server/package.json mcp-servers/chembl-server/package-lock.json ./
RUN npm ci --production

COPY mcp-servers/chembl-server/index.js ./

# ─────────────────────────────────────────────────────────────────────────────
FROM node:22-alpine

LABEL org.opencontainers.image.title="sciloop-chembl-mcp"
LABEL org.opencontainers.image.description="MCP server wrapping ChEMBL REST API for SciLoop"
LABEL org.opencontainers.image.version="1.0.0"

RUN addgroup -g 1001 sciloop && adduser -u 1001 -G sciloop -s /bin/sh -D sciloop

WORKDIR /app
COPY --from=builder --chown=sciloop:sciloop /app /app

USER sciloop

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD pgrep -f "node index.js" || exit 1

ENTRYPOINT ["node", "index.js"]
