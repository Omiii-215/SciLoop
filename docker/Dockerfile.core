# ─────────────────────────────────────────────────────────────────────────────
# SciLoop — Core Services Dockerfile
# Campaign manager, hypothesis engine, belief updater, experiment selector,
# policy engine — the Phase 2 closed-loop intelligence layer
# ─────────────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

# Copy core package
COPY core/package.json ./
RUN echo '{}' > package-lock.json

# Copy all core engine modules
COPY core/*.js ./

# ─────────────────────────────────────────────────────────────────────────────
FROM node:22-alpine

LABEL org.opencontainers.image.title="sciloop-core"
LABEL org.opencontainers.image.description="SciLoop core engines: campaign manager, hypothesis engine, policy engine"
LABEL org.opencontainers.image.version="2.0.0"

RUN addgroup -g 1001 sciloop && adduser -u 1001 -G sciloop -s /bin/sh -D sciloop

WORKDIR /app
COPY --from=builder --chown=sciloop:sciloop /app /app

USER sciloop

ENTRYPOINT ["node"]
