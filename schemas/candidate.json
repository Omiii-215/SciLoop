{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MoleculeCandidate",
  "description": "A candidate molecule identified and scored during a SciLoop research campaign",
  "type": "object",
  "required": ["id", "campaign_id", "smiles", "source", "created_at"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this candidate"
    },
    "campaign_id": {
      "type": "string",
      "format": "uuid",
      "description": "ID of the parent research campaign"
    },
    "smiles": {
      "type": "string",
      "description": "Canonical SMILES representation of the molecule"
    },
    "inchi_key": {
      "type": ["string", "null"],
      "description": "InChIKey for unique identification"
    },
    "source": {
      "type": "string",
      "description": "Where this candidate came from (e.g., 'ChEMBL:CHEMBL12345', 'de_novo_generation')"
    },
    "source_database": {
      "type": ["string", "null"],
      "enum": ["ChEMBL", "PubChem", "ZINC", "de_novo", null]
    },
    "source_id": {
      "type": ["string", "null"],
      "description": "ID in the source database (e.g., ChEMBL compound ID)"
    },
    "properties": {
      "type": "object",
      "description": "Computed molecular properties",
      "properties": {
        "molecular_weight": { "type": "number" },
        "logp": { "type": "number" },
        "hbd": { "type": "integer", "description": "Hydrogen bond donors" },
        "hba": { "type": "integer", "description": "Hydrogen bond acceptors" },
        "tpsa": { "type": "number", "description": "Topological polar surface area" },
        "rotatable_bonds": { "type": "integer" },
        "num_rings": { "type": "integer" }
      }
    },
    "filters": {
      "type": "object",
      "description": "Results of molecular filter checks",
      "properties": {
        "valid_structure": { "type": "boolean" },
        "lipinski_pass": { "type": "boolean", "description": "Passes Lipinski Rule of Five" },
        "pains_pass": { "type": "boolean", "description": "No PAINS substructure alerts" },
        "pass_all": { "type": "boolean", "description": "Passes all filters" }
      }
    },
    "score_vector": {
      "type": "object",
      "description": "Multi-objective score — NOT a single opaque number. Trade-offs must be exposed.",
      "properties": {
        "drug_likeness": { "type": "number", "minimum": 0, "maximum": 1 },
        "pains_clean": { "type": "number", "minimum": 0, "maximum": 1 },
        "mw_penalty": { "type": "number", "minimum": 0, "maximum": 1 },
        "logp_optimal": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "composite_note": {
      "type": "string",
      "default": "This is a weighted heuristic, NOT a validated metric",
      "description": "Disclaimer — agent must never present scores as validated results"
    },
    "known_activity": {
      "type": ["object", "null"],
      "description": "Known bioactivity data from ChEMBL if available",
      "properties": {
        "target_chembl_id": { "type": "string" },
        "activity_type": { "type": "string", "description": "e.g., IC50, Ki, EC50" },
        "activity_value": { "type": "number" },
        "activity_unit": { "type": "string" },
        "assay_description": { "type": "string" }
      }
    },
    "rank": {
      "type": ["integer", "null"],
      "description": "Rank within the campaign (set after scoring)"
    },
    "status": {
      "type": "string",
      "enum": ["identified", "filtered", "scored", "approved", "rejected"],
      "default": "identified"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
