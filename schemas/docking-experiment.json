{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sciloop.org/schemas/docking-experiment.json",
  "title": "DockingExperiment",
  "description": "Schema for molecular docking experiments, binding poses, affinity scores, and contact residues in SciLoop Phase 5.",
  "type": "object",
  "required": [
    "id",
    "campaign_id",
    "receptor",
    "ligand",
    "grid_box",
    "binding_affinity_kcal_mol",
    "ligand_efficiency",
    "poses",
    "evidence_type",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "campaign_id": {
      "type": "string",
      "format": "uuid"
    },
    "experiment_id": {
      "type": "string",
      "format": "uuid"
    },
    "receptor": {
      "type": "object",
      "required": ["pdb_id", "gene_name"],
      "properties": {
        "pdb_id": { "type": "string" },
        "gene_name": { "type": "string" },
        "chain_id": { "type": "string" },
        "resolution_angstrom": { "type": "number" },
        "structure_source": { "type": "string", "enum": ["pdb_xray", "pdb_cryoem", "alphafold_predicted"] }
      }
    },
    "ligand": {
      "type": "object",
      "required": ["candidate_id", "smiles"],
      "properties": {
        "candidate_id": { "type": "string", "format": "uuid" },
        "smiles": { "type": "string" },
        "heavy_atom_count": { "type": "integer" },
        "rotatable_bonds": { "type": "integer" }
      }
    },
    "grid_box": {
      "type": "object",
      "required": ["center_x", "center_y", "center_z", "size_x", "size_y", "size_z"],
      "properties": {
        "center_x": { "type": "number" },
        "center_y": { "type": "number" },
        "center_z": { "type": "number" },
        "size_x": { "type": "number" },
        "size_y": { "type": "number" },
        "size_z": { "type": "number" },
        "binding_pocket_name": { "type": "string" }
      }
    },
    "binding_affinity_kcal_mol": {
      "type": "number",
      "description": "Calculated binding free energy estimate in kcal/mol (more negative indicates tighter predicted binding)."
    },
    "ligand_efficiency": {
      "type": "number",
      "description": "Ligand efficiency = -affinity / heavy_atom_count (kcal/mol/heavy atom)."
    },
    "poses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pose_rank", "affinity_kcal_mol", "rmsd_to_best_angstrom"],
        "properties": {
          "pose_rank": { "type": "integer", "minimum": 1 },
          "affinity_kcal_mol": { "type": "number" },
          "rmsd_to_best_angstrom": { "type": "number", "minimum": 0 },
          "contact_residues": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["residue_name", "residue_number", "interaction_type"],
              "properties": {
                "residue_name": { "type": "string" },
                "residue_number": { "type": "integer" },
                "interaction_type": { "type": "string", "enum": ["hydrogen_bond", "salt_bridge", "pi_pi_stacking", "pi_cation", "hydrophobic"] },
                "distance_angstrom": { "type": "number" }
              }
            }
          }
        }
      }
    },
    "docking_software": {
      "type": "string",
      "description": "Engine used (e.g., AutoDock Vina 1.2, smina, or empirical force field)."
    },
    "evidence_type": {
      "type": "string",
      "const": "computational_prediction"
    },
    "disclaimer": {
      "type": "string",
      "description": "Explicit scientific disclaimer that docking scores are in silico proxies and do not constitute thermodynamic proof."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
