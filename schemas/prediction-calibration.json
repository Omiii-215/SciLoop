{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sciloop.org/schemas/prediction-calibration.json",
  "title": "PredictionCalibration",
  "description": "Schema for prediction calibration records in SciLoop Phase 6. Tracks how well computational predictions match experimental observations.",
  "type": "object",
  "required": [
    "id",
    "source",
    "data_points",
    "status",
    "regression_metrics",
    "adjusted_confidence_weight",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "string",
      "description": "The prediction engine/tool being calibrated."
    },
    "target_class": {
      "type": "string",
      "description": "Target class for stratified calibration (e.g., 'kinase', 'GPCR')."
    },
    "data_points": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of (prediction, observation) pairs used."
    },
    "status": {
      "type": "string",
      "enum": ["calibrated", "insufficient_data"]
    },
    "regression_metrics": {
      "type": "object",
      "required": [
        "mean_signed_log_error",
        "mean_absolute_log_error",
        "rmse_log",
        "rank_correlation",
        "bias_direction"
      ],
      "properties": {
        "mean_signed_log_error": {
          "type": "number",
          "description": "Mean signed log10 error (positive = overpredicts)."
        },
        "mean_absolute_log_error": {
          "type": "number",
          "description": "Mean absolute log10 error."
        },
        "rmse_log": {
          "type": "number",
          "description": "Root mean squared log10 error."
        },
        "std_dev_log": {
          "type": "number",
          "description": "Standard deviation of signed log10 errors."
        },
        "rank_correlation": {
          "type": "number",
          "minimum": -1,
          "maximum": 1,
          "description": "Pearson correlation on log-transformed values."
        },
        "systematic_bias": {
          "type": "number"
        },
        "bias_direction": {
          "type": "string",
          "enum": ["overpredicts", "underpredicts", "unbiased"]
        }
      }
    },
    "binary_metrics": {
      "type": ["object", "null"],
      "properties": {
        "brier_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Brier score for binary active/inactive classification."
        },
        "calibration_curve": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "bin_lower": { "type": "number" },
              "bin_upper": { "type": "number" },
              "count": { "type": "integer" },
              "mean_predicted_confidence": { "type": "number" },
              "observed_fraction_active": { "type": "number" },
              "calibration_gap": { "type": "number" }
            }
          }
        }
      }
    },
    "adjusted_confidence_weight": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Updated confidence weight for this prediction source."
    },
    "previous_confidence_weight": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "calibration_interval": {
      "type": "object",
      "properties": {
        "lower_bound_log": { "type": "number" },
        "upper_bound_log": { "type": "number" },
        "coverage": { "type": "number" },
        "description": { "type": "string" }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
