{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sciloop.org/schemas/reproducibility-record.json",
  "title": "ReproducibilityRecord",
  "description": "Schema for cryptographic provenance and computational reproducibility of scientific experiment runs",
  "type": "object",
  "required": [
    "run_id",
    "campaign_id",
    "experiment_id",
    "experiment_type",
    "random_seed",
    "hashes",
    "provenance"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "campaign_id": {
      "type": "string"
    },
    "experiment_id": {
      "type": "string"
    },
    "experiment_type": {
      "type": "string"
    },
    "random_seed": {
      "type": "integer"
    },
    "container_image": {
      "type": "string"
    },
    "git_commit": {
      "type": "string"
    },
    "hashes": {
      "type": "object",
      "required": ["input_hash", "parameter_hash", "execution_fingerprint"],
      "properties": {
        "input_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "parameter_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "output_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "execution_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["input_data", "parameters"],
      "properties": {
        "input_data": { "type": "object" },
        "parameters": { "type": "object" },
        "output_data": { "type": "object" },
        "hardware_info": { "type": "object" }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
