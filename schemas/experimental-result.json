{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sciloop.org/schemas/experimental-result.json",
  "title": "ExperimentalResult",
  "description": "Schema for validated wet-lab / experimental observations ingested into SciLoop Phase 6. These are the highest-trust evidence type in the hierarchy.",
  "type": "object",
  "required": [
    "id",
    "campaign_id",
    "candidate_id",
    "assay_type",
    "measurements",
    "lab_notebook_ref",
    "performed_by",
    "evidence_type",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "campaign_id": {
      "type": "string",
      "format": "uuid"
    },
    "candidate_id": {
      "type": "string",
      "format": "uuid"
    },
    "assay_type": {
      "type": "string",
      "enum": [
        "binding_affinity",
        "enzymatic_inhibition",
        "cell_viability",
        "selectivity_panel",
        "admet_experimental",
        "in_vivo_efficacy"
      ],
      "description": "Type of experimental assay performed."
    },
    "assay_description": {
      "type": "string",
      "description": "Human-readable description of the assay."
    },
    "measurements": {
      "type": "object",
      "description": "Key-value pairs of metric name to measured value.",
      "additionalProperties": {
        "type": "number"
      }
    },
    "activity_classification": {
      "type": "object",
      "required": ["label"],
      "properties": {
        "label": {
          "type": "string",
          "enum": ["active", "moderate", "inactive", "unknown"]
        },
        "metric": {
          "type": ["string", "null"]
        },
        "value": {
          "type": ["number", "null"]
        },
        "threshold": {
          "type": ["number", "null"]
        }
      }
    },
    "conditions": {
      "type": "object",
      "description": "Experimental conditions (concentration, cell line, temperature, etc.).",
      "properties": {
        "concentration_uM": { "type": "number" },
        "cell_line": { "type": "string" },
        "temperature_celsius": { "type": "number" },
        "incubation_hours": { "type": "number" },
        "buffer": { "type": "string" }
      },
      "additionalProperties": true
    },
    "lab_notebook_ref": {
      "type": "string",
      "description": "Laboratory notebook or ELN reference for provenance."
    },
    "performed_by": {
      "type": "string",
      "description": "Researcher name or lab identifier."
    },
    "protocol_reference": {
      "type": ["string", "null"],
      "description": "Protocol DOI or SOP reference."
    },
    "replicate_count": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "description": "Number of biological replicates."
    },
    "quality_metrics": {
      "type": "object",
      "description": "Quality indicators for the assay.",
      "properties": {
        "z_prime": {
          "type": "number",
          "minimum": -1,
          "maximum": 1,
          "description": "Z-prime factor (>0.5 is excellent)."
        },
        "cv_percent": {
          "type": "number",
          "minimum": 0,
          "description": "Coefficient of variation (%)."
        },
        "signal_to_noise": {
          "type": "number",
          "minimum": 0
        },
        "signal_to_background": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "validation_status": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["high_confidence", "acceptable", "low_confidence"]
        },
        "score": { "type": "integer" },
        "flags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "evidence_type": {
      "type": "string",
      "const": "experimentally_validated"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
