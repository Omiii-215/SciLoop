{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BeliefUpdate",
  "description": "Records a change in hypothesis confidence, creating an audit trail of how the agent's scientific understanding evolved during a campaign",
  "type": "object",
  "required": ["id", "campaign_id", "hypothesis_id", "new_confidence", "trigger_type", "reasoning", "created_at"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this belief update"
    },
    "campaign_id": {
      "type": "string",
      "format": "uuid",
      "description": "ID of the parent research campaign"
    },
    "hypothesis_id": {
      "type": "string",
      "format": "uuid",
      "description": "The hypothesis whose confidence changed"
    },
    "experiment_id": {
      "type": ["string", "null"],
      "format": "uuid",
      "description": "The experiment that triggered this update (if applicable)"
    },
    "previous_confidence": {
      "type": ["number", "null"],
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Confidence before the update (null for initial assignment)"
    },
    "new_confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Confidence after the update"
    },
    "delta": {
      "type": "number",
      "description": "Change in confidence (new - previous). Positive = strengthened, negative = weakened"
    },
    "previous_status": {
      "type": ["string", "null"],
      "enum": ["proposed", "under_investigation", "supported", "refuted", "inconclusive", null]
    },
    "new_status": {
      "type": "string",
      "enum": ["proposed", "under_investigation", "supported", "refuted", "inconclusive"]
    },
    "trigger_type": {
      "type": "string",
      "enum": [
        "evidence_added",
        "evidence_contradicted",
        "experiment_completed",
        "critic_review",
        "human_feedback",
        "re_evaluation"
      ],
      "description": "What caused this belief update"
    },
    "triggering_evidence_ids": {
      "type": "array",
      "items": { "type": "string", "format": "uuid" },
      "description": "Evidence records that caused this update"
    },
    "reasoning": {
      "type": "string",
      "description": "Agent's reasoning for why confidence changed — required for reproducibility"
    },
    "provenance": {
      "type": "object",
      "description": "Provenance metadata for the update",
      "properties": {
        "tool_name": { "type": "string" },
        "iteration": { "type": "integer" },
        "campaign_phase": { "type": "string" }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
