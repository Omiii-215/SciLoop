{
  "annotations": {
    "list": []
  },
  "description": "SciLoop — Research Campaign Monitoring Dashboard",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Campaign Overview",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "title": "Active Campaigns",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "targets": [
        {
          "expr": "sciloop_campaigns_active_total",
          "legendFormat": "Active"
        }
      ]
    },
    {
      "title": "Hypotheses by Status",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 4, "y": 1 },
      "targets": [
        { "expr": "sciloop_hypotheses_total{status=\"proposed\"}", "legendFormat": "Proposed" },
        { "expr": "sciloop_hypotheses_total{status=\"under_investigation\"}", "legendFormat": "Under Investigation" },
        { "expr": "sciloop_hypotheses_total{status=\"supported\"}", "legendFormat": "Supported" },
        { "expr": "sciloop_hypotheses_total{status=\"refuted\"}", "legendFormat": "Refuted" },
        { "expr": "sciloop_hypotheses_total{status=\"inconclusive\"}", "legendFormat": "Inconclusive" }
      ]
    },
    {
      "title": "Average Hypothesis Confidence",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.4 },
              { "color": "green", "value": 0.7 }
            ]
          }
        }
      },
      "targets": [
        { "expr": "avg(sciloop_hypothesis_confidence)", "legendFormat": "Avg Confidence" }
      ]
    },
    {
      "title": "Total Evidence Collected",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" } }
      },
      "targets": [
        { "expr": "sciloop_evidence_total", "legendFormat": "Evidence" }
      ]
    },
    {
      "title": "Candidates Passing Filters",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "targets": [
        { "expr": "sciloop_candidates_passing_total", "legendFormat": "Passing" }
      ]
    },
    {
      "title": "Worker & Queue Metrics",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }
    },
    {
      "title": "Task Queue Depth",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 20 }
        }
      },
      "targets": [
        { "expr": "sciloop_queue_pending_total", "legendFormat": "Pending" },
        { "expr": "sciloop_queue_processing_total", "legendFormat": "Processing" },
        { "expr": "sciloop_queue_dead_letter_total", "legendFormat": "Dead Letter" }
      ]
    },
    {
      "title": "Experiment Throughput (per minute)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "targets": [
        { "expr": "rate(sciloop_experiments_completed_total[5m]) * 60", "legendFormat": "Completed/min" },
        { "expr": "rate(sciloop_experiments_failed_total[5m]) * 60", "legendFormat": "Failed/min" }
      ]
    },
    {
      "title": "Worker CPU Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{namespace=\"sciloop\",container=\"worker\"}[5m])",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "title": "Worker Memory Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "targets": [
        {
          "expr": "container_memory_working_set_bytes{namespace=\"sciloop\",container=\"worker\"} / 1024 / 1024",
          "legendFormat": "{{pod}} (MB)"
        }
      ]
    },
    {
      "title": "Budget Consumption",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 }
    },
    {
      "title": "Budget Usage by Category",
      "type": "bargauge",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 27 },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "orange", "value": 80 },
              { "color": "red", "value": 95 }
            ]
          }
        }
      },
      "targets": [
        { "expr": "(sciloop_budget_used{category=\"literature_queries\"} / sciloop_budget_limit{category=\"literature_queries\"}) * 100", "legendFormat": "Literature Queries" },
        { "expr": "(sciloop_budget_used{category=\"database_queries\"} / sciloop_budget_limit{category=\"database_queries\"}) * 100", "legendFormat": "Database Queries" },
        { "expr": "(sciloop_budget_used{category=\"sandbox_executions\"} / sciloop_budget_limit{category=\"sandbox_executions\"}) * 100", "legendFormat": "Sandbox Executions" },
        { "expr": "(sciloop_budget_used{category=\"iterations\"} / sciloop_budget_limit{category=\"iterations\"}) * 100", "legendFormat": "Iterations" }
      ]
    },
    {
      "title": "Infrastructure",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 }
    },
    {
      "title": "PostgreSQL Connections",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 34 },
      "targets": [
        { "expr": "pg_stat_activity_count{datname=\"sciloop\"}", "legendFormat": "Active Connections" }
      ]
    },
    {
      "title": "Redis Memory Usage",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 34 },
      "targets": [
        { "expr": "redis_memory_used_bytes / 1024 / 1024", "legendFormat": "Used (MB)" },
        { "expr": "redis_memory_max_bytes / 1024 / 1024", "legendFormat": "Max (MB)" }
      ]
    },
    {
      "title": "MinIO Storage Used",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 34 },
      "targets": [
        { "expr": "minio_bucket_usage_total_bytes / 1024 / 1024", "legendFormat": "{{bucket}} (MB)" }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["sciloop", "research", "drug-discovery"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "SciLoop — Research Campaign Dashboard",
  "uid": "sciloop-main",
  "version": 1
}
